{:paths   ["src/clj" "src/cljc" "src/cljs" "resources" "test"]
 :deps    {ai.dyal/ducktape               {:mvn/version "0.1.0-SNAPSHOT"}
           bidi/bidi                      {:mvn/version "2.1.6"}
           ch.qos.logback/logback-classic {:mvn/version "1.6.5"}
           cheshire/cheshire              {:mvn/version "6.2.0"}
           com.techascent/tmd-parquet     {:mvn/version "1.001"}
           garden/garden                  {:mvn/version "1.3.10"}
           info.sunng/ring-jetty9-adapter {:mvn/version "0.40.4"}
           integrant/integrant            {:mvn/version "1.0.1"}
           io.github.perrygeo/cartoj      {:mvn/version "0.3.0"}
           markdown-clj/markdown-clj      {:mvn/version "1.12.10"}
           reagent/reagent                {:mvn/version "2.0.1"}
           ring/ring-core                 {:mvn/version "1.15.5"}
           ring/ring-headers              {:mvn/version "0.4.0"}
           ring/ring-ssl                  {:mvn/version "0.4.0"}
           techascent/tech.ml.dataset     {:mvn/version "8.027"}}
 :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
 :aliases {:shadow-cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "3.5.5"}}}
           :dev         {:extra-paths ["dev"]
                         :extra-deps  {cider/piggieback     {:mvn/version "0.7.0"}
                                       integrant/repl       {:mvn/version "0.5.1"}
                                       thheller/shadow-cljs {:mvn/version "3.5.5"}}
                         :main-opts   ["-m" "shadow.cljs.devtools.cli" "server"]}
           :build       {:extra-paths ["build"]
                         :extra-deps  {io.github.clojure/tools.build
                                       {:git/tag "v0.10.14"
                                        :git/sha "1176afd"
                                        :git/url "https://github.com/clojure/tools.build"}}
                         :ns-default  build}
           :test        {:extra-paths ["test"]
                         :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                         :main-opts   ["-m" "kaocha.runner"]}
           :coverage    {:extra-paths ["test"]
                         :extra-deps  {cloverage/cloverage {:mvn/version "1.2.4"}}
                         :main-opts   ["-m" "cloverage.coverage"
                                       "--src-ns-path" "src/clj"
                                       "--src-ns-path" "src/cljc"
                                       "--test-ns-path" "test"
                                       "--output" "target/coverage"]}
           :doc         {:extra-paths ["build"]
                         :extra-deps  {codox/codox                {:mvn/version "0.10.8"}
                                       org.clojure/clojurescript {:mvn/version "1.12.145"}}
                         :exec-fn     build.docs/generate}}}
