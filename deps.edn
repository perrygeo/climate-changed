{:paths   ["src/clj" "src/cljc" "src/cljs" "src/sql" "resources" "test"]

 :deps    {bidi/bidi                         {:mvn/version "2.1.6"}
           ch.qos.logback/logback-classic    {:mvn/version "1.6.4"}
           cheshire/cheshire                 {:mvn/version "6.2.0"}
           com.github.seancorfield/honeysql  {:mvn/version "2.7.1479"}
           com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
           com.zaxxer/HikariCP               {:mvn/version "7.1.0"}
           garden/garden                     {:git/url "https://github.com/noprompt/garden"
                                              :git/sha "7a47503d0481382f85b643ae431cefb2ad88ee4c"}
           info.sunng/ring-jetty9-adapter    {:mvn/version "0.40.4"}
           integrant/integrant               {:mvn/version "1.0.1"}
           io.github.perrygeo/cartoj         {:mvn/version "0.3.0"}
           techascent/tech.ml.dataset        {:mvn/version "8.026"}
           com.techascent/tmd-parquet        {:mvn/version "1.001"}
           migratus/migratus                 {:mvn/version "1.6.7"}
           org.postgresql/postgresql         {:mvn/version "42.7.13"}
           reagent/reagent                   {:mvn/version "2.0.1"}
           ring/ring-core                    {:mvn/version "1.15.5"}}

 :aliases {:shadow-cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "3.5.3"}}}

           :dev         {:extra-paths ["dev"]
                         :extra-deps  {cider/piggieback     {:mvn/version "0.7.0"}
                                       integrant/repl       {:mvn/version "0.5.1"}
                                       thheller/shadow-cljs {:mvn/version "3.5.3"}}
                         :main-opts   ["-m" "shadow.cljs.devtools.cli" "server"]}

           :build       {:extra-paths ["build"]
                         :extra-deps  {io.github.clojure/tools.build
                                       {:git/tag "v0.10.14"
                                        :git/sha "1176afd"
                                        :git/url "https://github.com/clojure/tools.build"}}
                         :ns-default build}

           :test        {:extra-paths ["test"]
                         :extra-deps  {io.github.cognitect-labs/test-runner
                                       {:git/tag "v0.5.1"
                                        :git/sha "dfb30dd"}}
                         :exec-fn     cognitect.test-runner.api/test}}}
