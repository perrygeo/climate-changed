# Copy to terraform.tfvars and fill in.

region        = "us-east-1"
instance_type = "t3.small"

# Contents of your public key, e.g. `cat ~/.ssh/id_ed25519.pub`.
ssh_public_key = "ssh-ed25519 AAAA... you@host"

# Local private key matching the public key above, used by nixos-rebuild to SSH in.
ssh_private_key_path = "~/.ssh/id_ed25519"

# Lock SSH down to your IP. Find it with: curl -s https://checkip.amazonaws.com
ssh_allowed_cidr = "203.0.113.7/32"

# Must be globally unique across all of S3.
data_bucket_name = "climate-changed-timeseries"

# Leave false for the first apply. Flip to true after the ACM cert is validated.
enable_custom_domain = false
domain_name          = "climate-changed.org"
